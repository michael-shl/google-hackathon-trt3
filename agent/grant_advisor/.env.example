# Copy to .env (git-ignored): cp .env.example .env
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=qwiklabs-gcp-04-7254cc802c4d
GOOGLE_CLOUD_LOCATION=us-central1
GRANT_ADVISOR_MODEL=gemini-2.5-flash

# true = built-in mock corridor (works offline); false = BigQuery a4i_econ + LocalEconomy graph
USE_MOCK_DATA=true
BQ_DATASET=a4i_econ
BQ_GRAPH=LocalEconomy

# Leave empty to use local lookup tools; set to the Cloud Run URL (terraform output toolbox_url)
# or http://127.0.0.1:5000 to use MCP Toolbox.
TOOLBOX_URL=
TOOLBOX_TOOLSET=grant_toolset
